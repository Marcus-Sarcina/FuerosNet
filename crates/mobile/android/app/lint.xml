<?xml version="1.0" encoding="utf-8"?>
<!-- The generated binding probes for `java.lang.ref.Cleaner` with
     `Class.forName` and falls back to JNA's cleaner below API 33 — correct,
     and invisible to lint, which reports the guarded calls as NewApi errors
     against minSdk 31. The exemption is scoped to the generated tree and
     lives HERE because minSdk is this app's: the library carries no
     Android lint constraint, and every other Kotlin consumer gets the
     generator's default cleaner [author, 2026-09-27]. -->
<lint>
    <issue id="NewApi">
        <ignore path="src/generated/kotlin" />
    </issue>
    <!-- SetTextI18n: the app is not localised yet, and the words a screen
         shows are written where it shows them, in the author's wording.
         Moving them into resources is the translation's work, not lint's;
         revisit this when the app is translated. -->
    <issue id="SetTextI18n" severity="ignore" />
    <!-- UnusedResources, for two sets this shell does not own and so
         cannot prune. `colors.xml` is generated from
         `crates/brand/tokens.toml` by `crates/brand/generate.py`, which
         checks it for drift: it carries the whole dark set, whichever of it
         the theme happens to name. The italic faces are the brand's
         (`crates/brand/res/font`), shared with the desktop, which draws
         them; this shell draws the upright two. -->
    <issue id="UnusedResources">
        <ignore path="src/main/res/values/colors.xml" />
        <ignore regexp="R\.font\.geist(_mono)?_italic" />
    </issue>
</lint>
