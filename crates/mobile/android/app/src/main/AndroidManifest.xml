<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The kernel dials the serving node itself; nothing else here talks
         to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Fueros"
        android:allowBackup="false">

        <!-- Home is the launcher and navigation-first; it brings the kernel
             up and takes a provision extra. The rest are destinations. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ConversationsActivity" android:exported="false" />
        <activity android:name=".MeetActivity" android:exported="false" />
        <activity android:name=".ConversationActivity" android:exported="false" />
        <activity android:name=".PlaceholderActivity" android:exported="false" />
    </application>
</manifest>
