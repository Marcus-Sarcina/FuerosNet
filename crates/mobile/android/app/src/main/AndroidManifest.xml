<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The kernel dials the serving node itself; nothing else here talks
         to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The optical channel's two QRs (`wire-format.md` §14.3.1): the
         bootstrap one read rear-camera, the anchor exchange selfie-camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Bluetooth LE as a bearer, first in §14.3.1's hierarchy. The
         neverForLocation flag is the truthful one: this derives no location
         and offers Bluetooth as no proximity channel (design §1.3 bars
         RSSI from the distance channel, and that bar stands). API 31 is
         this app's floor, so the legacy location permission is not
         needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The NFC tap, design §7.6.3's second channel. Friction, not a
         distance guarantee: the exchange carries only the public
         ceremony-id, and the tap is physical-range evidence weighed by the
         counterparty rather than relied on. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- Neither is required to install: a device without one carries the
         exchange another way, and `light-client-requirements.md` §1.3 has a
         missing capability reported unavailable rather than absent. -->
    <uses-feature android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce"
        android:required="false" />

    <application
        android:label="Fueros"
        android:allowBackup="false">

        <!-- Home is the launcher and navigation-first; it brings the kernel
             up and takes a provision extra. The rest are destinations. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ConversationsActivity" android:exported="false" />
        <activity android:name=".MeetActivity" android:exported="false" />
        <activity android:name=".ConversationActivity" android:exported="false" />
        <activity android:name=".PlaceholderActivity" android:exported="false" />

        <!-- The tap's card side (D3). exported because the NFC stack, a
             system service, binds it when a reader selects the AID; it
             carries only the public ceremony-id and answers unknown with
             no ceremony open. -->
        <service
            android:name=".NfcCeremonyService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>
    </application>
</manifest>
