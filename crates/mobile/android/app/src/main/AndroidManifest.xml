<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The kernel dials the serving node itself; nothing else here talks
         to the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The default network coming back is handed to the kernel, which
         reaches for its peers (design §6.3); the shell reads the state and
         never the traffic. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The optical channel's two QRs (`wire-format.md` §14.3.1): the
         bootstrap one read rear-camera, the anchor exchange selfie-camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Bluetooth LE as a bearer, first in §14.3.1's hierarchy. The
         neverForLocation flag is the truthful one: this derives no location
         and offers Bluetooth as no evidence of nearness (the design uses
         no ranging, §7.6.3). API 31 is
         this app's floor, so the legacy location permission is not
         needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- the cue at the switch to capture: a buzz the person feels with the phones face to face -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Neither is required to install: a device without one carries the
         exchange another way, and `light-client-requirements.md` §1.3 has a
         missing capability reported unavailable rather than absent. -->
    <uses-feature android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- `FuerosApp` plants the log trees, the event sink and the crash
         handler, each only in the fieldtest flavour (`FuerosApp.kt`). -->
    <application
        android:name=".FuerosApp"
        android:label="Fueros"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Home is the launcher and navigation-first; it brings the kernel
             up and takes a provision extra. The rest are destinations. -->
        <activity
            android:name=".HomeActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ConversationsActivity" android:exported="false" />
        <!-- Portrait, fixed: D2 has the phone turned around to face the
             counterparty, and a rotation would rebuild the screen, restart
             the camera and reset the read at the moment it matters. -->
        <activity android:name=".MeetActivity" android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".ConversationActivity" android:exported="false" />
        <activity android:name=".PlaceholderActivity" android:exported="false" />
        <activity android:name=".PeopleActivity" android:exported="false" />
        <activity android:name=".CatalogActivity" android:exported="false" />
        <!-- F's catalog and the device's own attach. Declared here because
             Home opens them: an Activity a screen names and a manifest does
             not declare throws where it is opened, and the catalog did from
             2026-10-16 until 2026-10-27, no test having touched an Activity.
             `ManifestTest` now holds every one a source names. -->
        <activity android:name=".AttachActivity" android:exported="false" />
        <!-- H3's provisioning pages, and the frame the node's own pages are
             presented in (PRD-12, PRD-13; §8.3). The frame is a separate
             Activity so that what it holds is a WebView and nothing else. -->
        <activity android:name=".OperatorActivity" android:exported="false" />
        <activity android:name=".NodePageActivity" android:exported="false" />

    </application>
</manifest>
