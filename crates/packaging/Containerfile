# =============================================================================
#  rhtnd as an image.  `infra-client-requirements.md` §9 opens by saying a node
#  is "distributed as a container or VM image"; this is that container.
#
#  TWO STAGES, because the crypto provider needs a C toolchain and the node
#  does not.  aws-lc-rs builds with cmake and a C compiler (design §5.2 names
#  it as the audited alternative, and quinn and rustls take it here), so the
#  builder carries them and the runtime carries the binary alone.
#
#  NO CA BUNDLE IN THE RUNTIME, deliberately.  The transport authenticates raw
#  public keys (RFC 7250, `wire-format.md` §9.1) and pins by keyhash, so there
#  is nothing a certificate store would ever be consulted for.  An image that
#  shipped one would be carrying a trust root this protocol does not have.
# =============================================================================

ARG RUST=1.98-bookworm
ARG RUNTIME=debian:bookworm-slim

FROM rust:${RUST} AS build

# cmake and clang for aws-lc-rs; nothing else is added to the builder
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake clang \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# the whole workspace: the daemon is a path dependency on nine crates beside
# it, and a partial copy would be a second manifest to keep in step
COPY . .

# **The releasable flavour by default.**  `releasable` and `fieldtest` are two
# flavours of one build and never both (`crates/README.md`); an operator runs
# the first, and the bench builds the second with --build-arg FLAVOUR=fieldtest.
ARG FLAVOUR=releasable
# No cache mounts: they need BuildKit, and this has to build under podman and
# under a plain docker alike.  A slower build is a smaller contract.
# **Two invocations for the field-test flavour, and why** [2026-11-03]:
# `rhtn-cli` depends on `rhtn-client` without `default-features = false`,
# so selecting both binaries in one command unifies `rhtn-client`'s
# `releasable` in beside the `fieldtest` asked for, and the two-flavours
# guard in its `lib.rs` stops the build.  The gate never met this because
# `check.sh`'s flavour lint selects the daemon and not the CLI.  **The
# flavour is the daemon's**: the CLI in this image is an operator's
# instrument and wants no diagnostic hooks, so it is built as it ships.
# **And the flavour names only this crate's own feature**: `rhtn-daemon`
# does not depend on `rhtn-client`, so the `rhtn-client/fieldtest` this
# line used to carry was never a feature it could set — the daemon is the
# leaf that caps `tracing`'s static level, and turning its default off is
# the whole of what keeps `rhtn-node`'s debug events in the binary.
RUN set -eu; \
    case "$FLAVOUR" in \
      releasable) cargo build --locked --release -p rhtn-daemon -p rhtn-cli ;; \
      fieldtest)  cargo build --locked --release --no-default-features \
                    -p rhtn-daemon --features fieldtest; \
                  cargo build --locked --release -p rhtn-cli ;; \
      *) echo "FLAVOUR is releasable or fieldtest, not $FLAVOUR" >&2; exit 2 ;; \
    esac; \
    install -m 0755 target/release/rhtnd /usr/local/bin/rhtnd; \
    install -m 0755 target/release/rhtn  /usr/local/bin/rhtn

FROM ${RUNTIME}

# **A node is not root.**  It reads a seed or a transport key at 0600 and
# writes a queue; nothing it does wants privilege, and a seized instance is a
# case this design plans for (design §18.1).  The uid is fixed so a mounted
# state volume can be chowned to it before the container ever runs.
# **The one client the node needs on its host's loopback** [author,
# 2026-11-02]: a socket-backed package has to be started by something with
# control of the machine, and this node has none — so it asks its own host
# over the loopback they share (`--network=host`), with a key its
# operator's client hands it for that act, which the host's
# `authorized_keys` binds to `rhtn-package-runner` and nothing else
# (`crates/packaging/package-runner.sh`). No server, no keys of its own,
# and no known hosts: what it may ask for is the host's to decide and is
# written down there.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client \
 && rm -rf /var/lib/apt/lists/*

ARG UID=10001
ARG GID=10001
RUN groupadd -g ${GID} rhtn \
 && useradd -u ${UID} -g ${GID} -M -d /var/lib/rhtn -s /usr/sbin/nologin rhtn \
 && mkdir -p /var/lib/rhtn \
 && chown ${UID}:${GID} /var/lib/rhtn \
 && chmod 0700 /var/lib/rhtn

COPY --from=build /usr/local/bin/rhtnd /usr/local/bin/rhtnd
COPY --from=build /usr/local/bin/rhtn  /usr/local/bin/rhtn
COPY packaging/entrypoint.sh /usr/local/bin/rhtnd-entrypoint
RUN chmod 0755 /usr/local/bin/rhtnd-entrypoint

# the state the operator mounts: the configuration, the keys, and everything
# that must survive a restart (`infra-client-requirements.md` §2)
VOLUME /var/lib/rhtn
USER rhtn
WORKDIR /var/lib/rhtn

# QUIC, and the STUN Binding requests the same address answers
# (`infra-client-requirements.md` §7, design §14.1.1)
EXPOSE 7447/udp
# the operator's surface: the one channel their client reaches this
# instance over (`rhtn_daemon::administration`)
EXPOSE 7449/tcp

ENTRYPOINT ["/usr/local/bin/rhtnd-entrypoint"]
